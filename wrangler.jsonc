{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watch-list",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watch-list",
      // Replace with the id printed by `npx wrangler d1 create watch-list`
      "database_id": "22a3010c-046c-4ff5-9529-8cdc4e301bef",
      "migrations_dir": "migrations",
      // `npm run dev` reads and writes the real (deployed) database, not a local copy
      "remote": true
    }
  ],
  "vars": {
    "REGION": "CA"
  },
  "observability": { "enabled": true }
}
